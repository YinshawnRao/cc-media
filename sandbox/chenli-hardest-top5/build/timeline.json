    {
      "key": "p2_zouma",
      "clip": "vert_zouma",
      "no": "02",
      "name": "《走马》",
      "plain": "走马",
      "year": "2015 · 如也",
      "show_start": 49.66,
      "show": 27.72,
      "tag": "松弛里，还藏着锋利",
      "note": "太平像念词，太满没了那口气。",
      "voice_dur": 17.375,
      "narration": "第二名，《走马》。听上去是一首很顺的民谣，真正难的，是叙事和气息。旋律不算夸张，可每一句都得有画面、有停顿、有递进。唱得太平，就像在念词，唱得太满，又没了走过一段旧事的那种轻。陈粒最绝的，是松弛里还藏着锋利，这两样，一般人很难同时拿住。",
      "start": 160.95,
      "end": 208.145,
      "seg_len": 47.195,
      "narr_start": 161.25,
      "narr_end": 178.625,
