    {
      "key": "p4_xiaoban",
      "clip": "vert_xiaoban",
      "no": "04",
      "name": "《小半》",
      "plain": "小半",
      "year": "2016 · 小梦大半",
      "show_start": 192.65,
      "show": 24.0,
      "tag": "情绪一直悬着，最难",
      "note": "用力多一分，那点心事就散了。",
      "voice_dur": 16.825,
      "narration": "第四名，《小半》。这首很红，但是真的难。整首歌快五分钟，气息线特别长，副歌还要在压抑和爆发之间来回拿捏。它不是靠高音难，是靠情绪一直悬着难。主歌要淡，副歌要痛，可痛还不能俗。一旦用力过猛，那点欲言又止的小心事，就没了。",
      "start": 69.17,
      "end": 112.095,
      "seg_len": 42.925,
      "narr_start": 69.47,
      "narr_end": 86.295,
      "full_start": 88.095,
      "media_seek": 173.725,
      "mseek": 173.725
    },
    {
      "key": "p3_guang",
      "clip": "vert_guang",
      "no": "03",
      "name": "《光》",
      "plain": "光",
      "year": "2015 · 如也",
      "show_start": 113.19,
      "show": 29.88,
      "tag": "声音要轻，但不能虚",
      "note": "唱过了，就丢了那股清冷。",
      "voice_dur": 16.875,
      "narration": "第三名，《光》。它藏在《如也》里，专辑里排第五，前面压着《奇妙能力歌》《历历万乡》这些更出名的歌，可《光》本身，最考验声音状态。它难在弱声和明亮度，声音要轻，但不能虚，情绪要亮，但不能甜。唱不好就发平，唱过头，又丢了那股清冷透明的劲儿。",
      "start": 112.095,
      "end": 160.95,
      "seg_len": 48.855,
      "narr_start": 112.395,
      "narr_end": 129.27,
      "full_start": 131.07,
