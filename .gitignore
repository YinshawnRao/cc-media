# =========================================================
#  cc-media .gitignore
#  原则：只入库「源」（脚本 / HTML 合成 / brief / 规范 / 字幕）。
#  所有可重下的素材、可重渲的产物、本地环境一律不入库。
#  精选封面案例的必要图片快照按下方窄范围例外留存。
#  跨机器同步重素材请走外置盘 / 网盘，git 扛不动 54G。
# =========================================================

# ---- 依赖 / 本地环境 ----
node_modules/
.hf-local/
.hyperframes/
hyperframes-local/
venv/
*.venv/
__pycache__/
*.pyc

# ---- 敏感：登录态，绝不入库 ----
cookies.txt
*cookies*.txt
*cookies*.json
.env
.env.*
!.env.example
!.env.sample
.npmrc
.pypirc
.netrc
*credentials*.json
*service-account*.json
*.p12
*.pfx
*.pem
*.key

# ---- 音频（配音/预混产物 + 下载音轨，可复现）----
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.opus
*.pcm

# 正式编号配音库的精选母带/样例是可复用源资产，窄范围入库。
!tools/tts/voices/CV*/reference.wav
!tools/tts/voices/CV*/examples/*.wav
!tools/tts/voices/baselines/kokoro/*.wav

# ---- 视频（下载素材 + 渲染成片，可复现）----
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.flv

# ---- 普通图片（封面 / QA 抽帧 / probe，默认不入库）----
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tiff

# 精选封面案例：只保留定稿、采用底图、移动端预览和必要输入参考。
!/references/covers/*/cover.png
!/references/covers/*/artwork.png
!/references/covers/*/mobile-preview.png
!/references/covers/*/inputs/*.png

# ---- 渲染 / 下载 / 素材 整目录（体积大，不入库）----
renders/
downloads/
clips/
audio/
raw/
*.part
*.ytdl

# ---- 编译缓存 / 二进制（保留 build/ 里的脚本源，只挡缓存与编译产物）----
.clang-module-cache/
*.swiftmodule
*.timestamp
watermark_renderer

# ---- 冷归档区（sandbox 老工程打包，体积大，整目录不入库）----
archive/

# ---- 临时 / 日志 / 系统 / 运行期 ----
tmp/
*.log
.DS_Store
.claude/*.lock
.claude/settings.local.json
.workbuddy/
chrome_all_cookies.txt

# ---- 项目内误装的依赖 / 渲染缓存 / 拷贝字体（可重建，不入库；vendor/gsap 等本地库仍入库）----
.deps/
.extract_cache/
.npm-cache/
*.hf-complete
*.ttc

# TTS 本地模型、独立运行时和生成缓存不入库。
tools/tts/models/
tools/tts/runtime/
tools/tts/research/**/outputs/

# ---- 仓库级实验 / 会话临时目录 ----
# sandbox 可丢弃且可能达到数百 GB；正式资产应先整理到 tools/ 或 production/。
/sandbox/
/.session_tmps/
# 根目录 probe 是临时探测残留；项目内的 <project>/probe/ 仍可按需入库。
/probe/
